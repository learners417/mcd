# ═══ LO QUE NO ENTRA AL REPO ═══
#
# MCD no tenía .gitignore. El 9 de noviembre, el primer commit hecho con
# `git add -A` se llevó 10.496 archivos —`node_modules` y `.next` enteros, con
# packs de webpack de 43 MB— y GitHub lo rechazó en el pre-receive. Eso es la
# señal buena: sin el rechazo, el repo quedaba con 2,2 millones de líneas que
# nadie escribió y los clones tardarían minutos.

# dependencias
node_modules/
# El lockfile, a propósito: MCD nunca tuvo uno, y subir el que se resuelve hoy
# cambia lo que Vercel instala respecto de lo que corre. Decisión de Javo —
# está anotada en README-BATERIA.md.
package-lock.json
.pnp
.pnp.js

# el build de Next
.next/
out/
build/
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# el entorno — ACÁ VIVEN LAS CLAVES, y no vuelven de git si entran
.env
.env.local
.env*.local
.env.production

# Vercel
.vercel

# el sistema operativo y los editores
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# registros
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
